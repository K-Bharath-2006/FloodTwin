# =========================================================================================
# SIH 2026: DAM BREAK INUNDATION HYDRODYNAMIC MODELLING & CITIZEN ALERT PLATFORM
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =========================================================================================

# -----------------------------------------------------------------------------------------
# 1. CORE ENVIRONMENT & SYSTEM SETTINGS
# -----------------------------------------------------------------------------------------
# Options: DEVELOPMENT | PRODUCTION | TEST
ENVIRONMENT=DEVELOPMENT
DEBUG=true
LOG_LEVEL=INFO

# Backend API Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1

# Security & JWT Authentication
# IMPORTANT: In production, generate a random 64-char key: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long-secure-damflood
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------------------
# 2. POSTGRESQL / POSTGIS DATABASE SETTINGS
# -----------------------------------------------------------------------------------------
# For local Docker PostGIS container:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=damflood_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/damflood_db

# (Optional SQLite fallback for portable offline testing)
# DATABASE_URL=sqlite:///./damflood_local.db

# -----------------------------------------------------------------------------------------
# 3. REDIS BROKER & BACKGROUND TASK WORKER SETTINGS
# -----------------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------------------
# 4. STORAGE & WORKSPACE PATHS
# -----------------------------------------------------------------------------------------
# Absolute or relative root directory for GIS exports, rasters, and datasets
STORAGE_PATH=./storage
# Directory for isolated solver execution workspaces (input/, output/, logs/)
SIMULATION_WORKSPACE_PATH=./simulation_runs

# -----------------------------------------------------------------------------------------
# 5. GOOGLE CLOUD PLATFORM (GCP) & GOOGLE OAUTH 2.0 CREDENTIALS
# -----------------------------------------------------------------------------------------
# 1. Go to Google Cloud Console (https://console.cloud.google.com/) -> APIs & Services -> Credentials
# 2. Create "OAuth 2.0 Client IDs" (Web Application)
# 3. Add Authorized Javascript Origins: http://localhost:5173, http://localhost:3000
# 4. Add Authorized Redirect URIs: http://localhost:5173/auth/callback, http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret-here

# -----------------------------------------------------------------------------------------
# 6. GOOGLE EARTH ENGINE (GEE) CREDENTIALS & SERVICE ACCOUNT
# -----------------------------------------------------------------------------------------
# 1. Go to Google Earth Engine (https://code.earthengine.google.com/) / Cloud Console
# 2. Create a Service Account (e.g. gee-flood-validator@<your-gcp-project-id>.iam.gserviceaccount.com)
# 3. Grant "Earth Engine Resource Viewer" / "Earth Engine User" role
# 4. Generate & download JSON Private Key to ./storage/gee-service-key.json
GEE_PROJECT=your-gcp-project-id
GEE_SERVICE_ACCOUNT=gee-flood-validator@your-gcp-project-id.iam.gserviceaccount.com
GEE_PRIVATE_KEY_FILE=./storage/gee-service-key.json

# (Optional: Inlined Service Account JSON private key string if file path is not used)
GEE_SERVICE_ACCOUNT_KEY_JSON=

# -----------------------------------------------------------------------------------------
# 7. FIREBASE CLOUD MESSAGING (FCM) & EMERGENCY PUSH NOTIFICATIONS
# -----------------------------------------------------------------------------------------
# 1. Go to Firebase Console (https://console.firebase.google.com/) -> Project Settings -> Service Accounts
# 2. Generate new private key JSON
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_CREDENTIALS_FILE=./storage/firebase-service-key.json

# -----------------------------------------------------------------------------------------
# 8. HYDRODYNAMIC SOLVERS CONFIGURATION (Delft3D-FM & DualSPHysics)
# -----------------------------------------------------------------------------------------
# Path to Delft3D-FM D-Flow FM binary executable (Linux: /opt/delft3dfm/bin/dflowfm, Windows: dflowfm.exe)
# If left empty, platform automatically runs the calibrated 2D Saint-Venant Shallow Water SWE Reference Engine
DELFT3D_EXECUTABLE=
DELFT3D_CONFIG=
DELFT3D_WORKDIR=./simulation_runs/delft3d
DELFT3D_TIMEOUT_SECONDS=7200

# Path to DualSPHysics SPH executable (Linux: /opt/dualsphysics/bin/linux/DualSPHysics5.2_CPU_linux64)
# If left empty, platform automatically runs the calibrated SPH Particle Kinematic Reference Engine
SPH_EXECUTABLE=
SPH_WORKDIR=./simulation_runs/sph
SPH_TIMEOUT_SECONDS=7200

# -----------------------------------------------------------------------------------------
# 9. HYDRODYNAMIC RISK THRESHOLDS & CLASSIFICATION MATRICES (Configurable)
# -----------------------------------------------------------------------------------------
# Level 1 (Warning): Low-lying floodplain awareness
RISK_LEVEL_1_DEPTH_THRESHOLD_M=0.10
RISK_LEVEL_1_VELOCITY_THRESHOLD_MS=0.20

# Level 2 (High Risk): Prepare evacuation & secure assets
RISK_LEVEL_2_DEPTH_THRESHOLD_M=0.50
RISK_LEVEL_2_VELOCITY_THRESHOLD_MS=1.00

# Level 3 (Critical Danger): Immediate evacuation required
RISK_LEVEL_3_DEPTH_THRESHOLD_M=1.50
RISK_LEVEL_3_VELOCITY_THRESHOLD_MS=2.50
RISK_LEVEL_3_ARRIVAL_TIME_MIN=60.0

# Alert Cooldown (Minutes before sending another alert to same geofence zone)
ALERT_COOLDOWN_MINUTES=15.0

# -----------------------------------------------------------------------------------------
# 10. FRONTEND & MOBILE APP CLIENT URLS (CORS)
# -----------------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","*"]
