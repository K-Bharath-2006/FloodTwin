# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials (NEVER COMMIT SENSITIVE KEYS)
# ------------------------------------------------------------------------------
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12
*.crt
*service-key*.json
*credentials*.json
*secret*.json
google-services.json
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# 2. Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ------------------------------------------------------------------------------
# 3. Node.js, Frontend & Mobile Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Vite / React Build output
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
*.local

# Expo & React Native
mobile/.expo/
mobile/dist/
mobile/web-build/
.expo-shared/
*.apk
*.aab
*.ipa

# ------------------------------------------------------------------------------
# 4. Scientific Simulation & GIS Big Data Outputs
# ------------------------------------------------------------------------------
# Scratch workspaces and temporary mesh files
storage/workspaces/*
!storage/workspaces/.gitkeep
storage/exports/*
!storage/exports/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep
storage/simulations/*
!storage/simulations/.gitkeep

# Large hydrodynamic array datasets (NetCDF, HDF5, GeoTIFF, raw Shapefile outputs)
*.nc
*.nc4
*.h5
*.hdf5
*.geotiff
*.dem
*.grd

# SQLite scratch & Local DBs
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

